{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "bites",
        "breakfast",
        "toast",
        "salat",
        "pasta",
        "dinner",
        "side",
        "juice",
        "smoothie",
        "hot_drinks",
        "cold_drinks",
        "milkshakes",
        "kids",
        "sweet"
      ],
      "description": "Menu category"
    },
    "name": {
      "type": "string",
      "description": "Item name"
    },
    "description": {
      "type": "string",
      "description": "Item description"
    },
    "price": {
      "type": "string",
      "description": "Item price (e.g. $9.95)"
    },
    "image_url": {
      "type": "string",
      "description": "Photo of the dish"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Whether item is currently available"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order within category"
    }
  },
  "required": [
    "category",
    "name",
    "price"
  ]
}