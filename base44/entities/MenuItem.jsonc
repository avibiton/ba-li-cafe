{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "description": "Menu category ID (matches MenuCategory.category_id)"
    },
    "name": {
      "type": "string",
      "description": "Item name"
    },
    "description": {
      "type": "string",
      "description": "Item description"
    },
    "price": {
      "type": "string",
      "description": "Item price (e.g. $9.95)"
    },
    "image_url": {
      "type": "string",
      "description": "Photo of the dish"
    },
    "is_available": {
      "type": "boolean",
      "default": true,
      "description": "Whether item is currently available"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order within category"
    }
  },
  "required": [
    "category",
    "name",
    "price"
  ]
}