{
  "name": "MenuCategory",
  "type": "object",
  "properties": {
    "category_id": {
      "type": "string",
      "description": "Unique slug identifier for the category"
    },
    "label": {
      "type": "string",
      "description": "Display name shown to customers"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order in sidebar/menu"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether category is visible on the public menu"
    }
  },
  "required": [
    "category_id",
    "label"
  ]
}